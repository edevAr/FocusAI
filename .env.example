# =============================================================================
# FocusAI — Plantilla de Variables de Entorno
# =============================================================================
# Copia este archivo como `.env` y ajusta los valores a tu entorno local.
# NUNCA subas el archivo `.env` real al repositorio (está en .gitignore).
# =============================================================================

# ---------------------------------------------------------------------------
# Airflow — Rutas del scheduler
# ---------------------------------------------------------------------------

# La ruta Compose se configura dentro de sus contenedores y no requiere rutas del host.

# Deshabilita la carga de los DAGs de ejemplo que vienen por defecto con Airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False

# ---------------------------------------------------------------------------
# MLflow — Servidor de seguimiento de experimentos
# ---------------------------------------------------------------------------

# URI del servidor MLflow. Usa http://127.0.0.1:5000 para desarrollo local
# o la URL del servidor remoto en producción.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_MODEL_NAME=productivity_ensemble
MLFLOW_STAGING_ALIAS=staging
MLFLOW_PRODUCTION_ALIAS=production
QUALITY_MIN_ACCURACY=0.75
QUALITY_MIN_F1=0.75
MODEL_CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# FocusAI API — Backend FastAPI
# ---------------------------------------------------------------------------

# URL base del servicio API de FocusAI (ajusta host/puerto si es necesario)
FOCUSAI_API_URL=http://127.0.0.1:8000
DATABASE_PATH=data/database.db

# ---------------------------------------------------------------------------
# Python — Resolución de módulos del proyecto
# ---------------------------------------------------------------------------

# Añade la raíz del proyecto al PYTHONPATH para que los imports relativos
# (config.settings, src.nlp.preprocess, etc.) funcionen correctamente
# tanto en desarrollo local como dentro del contenedor Docker.
PYTHONPATH=.
